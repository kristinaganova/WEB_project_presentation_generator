{
  "openapi": "3.0.0",
  "info": {
    "title": "Presentation Generator API",
    "description": "REST API for managing presentations, slides, and workspaces with real-time collaboration features",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost/WEB_project_presentation_generator/public",
      "description": "XAMPP Development Server"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health check"
    },
    {
      "name": "Presentations",
      "description": "Presentation management"
    },
    {
      "name": "Slides",
      "description": "Slide management"
    },
    {
      "name": "Workspaces",
      "description": "Workspace access"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check endpoint",
        "description": "Check if the API is running and accessible",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "OK"
                    },
                    "service": {
                      "type": "string",
                      "example": "Presentation Generator API"
                    },
                    "timestamp": {
                      "type": "integer",
                      "example": 1704067200000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/presentations": {
      "get": {
        "tags": ["Presentations"],
        "summary": "Get all presentations for authenticated user",
        "description": "Retrieves all presentations accessible by the current user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of presentations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Presentation"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": ["Presentations"],
        "summary": "Create new presentation",
        "description": "Creates a new presentation in the specified workspace",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["workspace_id", "title"],
                "properties": {
                  "workspace_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "My Presentation"
                  },
                  "language": {
                    "type": "string",
                    "enum": ["bg", "en"],
                    "default": "bg",
                    "example": "en"
                  },
                  "theme": {
                    "type": "string",
                    "enum": ["light", "dark"],
                    "default": "light",
                    "example": "light"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Presentation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 5
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/presentations/{id}": {
      "get": {
        "tags": ["Presentations"],
        "summary": "Get presentation by ID",
        "description": "Retrieves a specific presentation with all its slides",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Presentation ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Presentation details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "presentation": {
                          "$ref": "#/components/schemas/Presentation"
                        },
                        "slides": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Slide"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/slides": {
      "get": {
        "tags": ["Slides"],
        "summary": "Get slides for a presentation",
        "description": "Retrieves all slides for a specific presentation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "presentation_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Presentation ID"
          }
        ],
        "responses": {
          "200": {
            "description": "List of slides",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Slide"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": ["Slides"],
        "summary": "Create new slide",
        "description": "Creates a new slide in a presentation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["presentation_id", "title"],
                "properties": {
                  "presentation_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "Introduction"
                  },
                  "layout": {
                    "type": "string",
                    "enum": ["blank", "text", "title", "image-text"],
                    "default": "blank",
                    "example": "text"
                  },
                  "content": {
                    "type": "string",
                    "description": "JSON string containing slide elements",
                    "example": "{\"elements\": []}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Slide created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/slides/{id}": {
      "put": {
        "tags": ["Slides"],
        "summary": "Update slide",
        "description": "Updates an existing slide's content",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Slide ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Updated Title"
                  },
                  "layout": {
                    "type": "string",
                    "enum": ["blank", "text", "title", "image-text"],
                    "example": "text"
                  },
                  "content": {
                    "type": "string",
                    "description": "JSON string containing slide elements",
                    "example": "{\"elements\": [{\"type\": \"text\", \"content\": \"Hello World\"}]}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Slide updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Slide updated"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": ["Slides"],
        "summary": "Delete slide",
        "description": "Deletes a slide from a presentation",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Slide ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Slide deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Slide deleted"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/workspaces": {
      "get": {
        "tags": ["Workspaces"],
        "summary": "Get user workspaces",
        "description": "Retrieves all workspaces accessible by the authenticated user",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Workspace"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Session Token",
        "description": "Use your session ID as the Bearer token. You can get it from browser cookies (PHPSESSID) after logging in."
      }
    },
    "schemas": {
      "Presentation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "workspace_id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "My Presentation"
          },
          "language": {
            "type": "string",
            "enum": ["bg", "en"],
            "example": "en"
          },
          "theme": {
            "type": "string",
            "enum": ["light", "dark"],
            "example": "light"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01 12:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01 12:30:00"
          }
        }
      },
      "Slide": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "presentation_id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Introduction"
          },
          "layout": {
            "type": "string",
            "enum": ["blank", "text", "title", "image-text"],
            "example": "text"
          },
          "content": {
            "type": "string",
            "description": "JSON string containing slide elements",
            "example": "{\"elements\": []}"
          },
          "order_index": {
            "type": "integer",
            "example": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01 12:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01 12:30:00"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "My Workspace"
          },
          "owner_id": {
            "type": "integer",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01 12:00:00"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Error message"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "Unauthorized"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Access denied - insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "Access denied"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "Presentation not found"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request data",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "success": false,
              "error": "Missing required fields"
            }
          }
        }
      }
    }
  }
}
